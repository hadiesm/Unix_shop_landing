RewriteEngine On

# Canonicalize the homepage.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Canonicalize product/category index URLs to their clean trailing-slash URLs.
RewriteCond %{THE_REQUEST} \s/+((?:products|category)/[^\s?]+)/index\.html(?:[\s?]) [NC]
RewriteRule ^(?:products|category)/[^/]+/index\.html$ /%1/ [R=301,L]

# Do not expose maintenance/generator scripts publicly.
<FilesMatch "\.(py|bat)$">
    Require all denied
</FilesMatch>

# Serve sitemap and robots directly.
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Require all granted
</FilesMatch>
